# Copia questo file in .env e completa i valori.

# Obbligatoria: chiave API di Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Come deve chiamarti Jarvis (facoltativo)
JARVIS_USER_NAME=

# Password per aprire Jarvis. Obbligatoria se Jarvis è raggiungibile da altri dispositivi.
JARVIS_PASSWORD=

# Fuso orario e città, usati per orari, promemoria e ricerche web
JARVIS_TIMEZONE=Europe/Rome
JARVIS_CITY=
JARVIS_COUNTRY=IT

# Ricerca e lettura di pagine web (1 = attive, 0 = disattivate)
JARVIS_WEB=1

# Modello e livello di ragionamento (low = risposte più rapide, medium/high = più accurate)
JARVIS_MODEL=claude-opus-5-5
JARVIS_EFFORT=low

# Cartella in cui Jarvis salva conversazioni, memoria, note e promemoria
JARVIS_DATA_DIR=data
